# ============================================================================
# Core DNA AI Agency Platform - Environment Variables
# ============================================================================

# Frontend Environment
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:3001

# ============================================================================
# LLM & AI Providers
# ============================================================================

# Google Gemini (Primary for Brand DNA extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI (For CrewAI agents & Langflow)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# n8n Automation Workflows
# ============================================================================

# n8n Instance (self-hosted or cloud)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# ============================================================================
# CrewAI Agent Configuration
# ============================================================================

# CrewAI Model & Settings
CREWAI_MODEL=gpt-4-turbo
CREWAI_LLM_PROVIDER=openai
CREWAI_TEMPERATURE=0.5
CREWAI_MAX_TOKENS=2000

# ============================================================================
# Langflow Visual AI Flows
# ============================================================================

# Langflow Instance (self-hosted or Airtable)
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=your_langflow_api_key_here

# ============================================================================
# Email & PDF Generation
# ============================================================================

# Resend (Email API)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@coredna.io

# Gmail (Alternative - requires OAuth)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# PDF Generation (jsPDF handled client-side, but for server-side rendering)
PDF_SERVICE_URL=optional_pdf_service_url

# ============================================================================
# Social Media & Automation
# ============================================================================

# Twitter / X API
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Meta / Facebook API
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_access_token
META_BUSINESS_ACCOUNT_ID=your_meta_business_account_id

# LinkedIn API (Optional)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# ============================================================================
# Image Generation
# ============================================================================

# Ideogram API (For social graphics)
IDEOGRAM_API_KEY=your_ideogram_api_key_here

# Midjourney (Optional - Discord webhook)
MIDJOURNEY_WEBHOOK_URL=your_midjourney_webhook_url

# Stability AI (Alternative image generation)
STABILITY_API_KEY=your_stability_api_key_here

# ============================================================================
# Database & Storage
# ============================================================================

# Firebase/Firestore (For conversation logs & analytics)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Supabase (Alternative PostgreSQL)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# Authentication
# ============================================================================

# JWT Secret (For server-side auth if needed)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# Backend Server
# ============================================================================

# Server Configuration
PORT=3001
HOST=0.0.0.0

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn_here

# LogRocket (Session replay)
LOGROCKET_APP_ID=your_logrocket_app_id

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/Disable Features
ENABLE_N8N_WORKFLOWS=true
ENABLE_CREWAI_AGENTS=true
ENABLE_LANGFLOW_FLOWS=true
ENABLE_ANALYTICS=true
ENABLE_EXPORT=true

# Tier-based Features
UNLOCK_AUTOMATIONS_TIER=pro
UNLOCK_AGENTS_TIER=pro
UNLOCK_FLOWS_TIER=agency

# ============================================================================
# Deployment
# ============================================================================

# Fly.io / Vercel
FLY_APP_NAME=core-dna-agency
VERCEL_URL=your_vercel_deployment_url
